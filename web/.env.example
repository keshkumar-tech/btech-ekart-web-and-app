# API base URL. Leave empty in dev to use the Vite proxy (recommended).
# Dev with proxy:      VITE_API_BASE_URL=
# Point at an API:     VITE_API_BASE_URL=https://api.btechekart.com
VITE_API_BASE_URL=

# Razorpay public key id (safe to expose; the secret stays on the server).
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Google OAuth client id (for Google login button).
VITE_GOOGLE_CLIENT_ID=

# Site metadata
VITE_SITE_NAME=B.Tech eKart
VITE_SUPPORT_EMAIL=support@btechekart.com
VITE_WHATSAPP_LINK=https://wa.me/919999999999
VITE_TELEGRAM_LINK=https://t.me/btechekart
