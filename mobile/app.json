{
  "expo": {
    "name": "B.Tech eKart",
    "slug": "btech-ekart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "btechekart",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2874f0"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.btechekart.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture your payment screenshot.",
        "NSPhotoLibraryUsageDescription": "Used to attach your payment screenshot.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.btechekart.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2874f0"
      },
      "permissions": ["INTERNET", "CAMERA", "READ_MEDIA_IMAGES"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 23,
            "usesCleartextTraffic": false
          },
          "ios": {
            "deploymentTarget": "13.4"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow B.Tech eKart to attach your payment screenshot."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    }
  }
}
