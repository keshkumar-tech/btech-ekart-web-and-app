# API origin the app talks to.
# Android emulator maps the host machine to 10.0.2.2 — use that in dev, NOT localhost.
# Physical device: use your computer's LAN IP, e.g. http://192.168.1.5:8000
# Production:      https://api.btechekart.com
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Razorpay public key id (security: the SECRET stays on the server).
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Google OAuth client id (for Google login).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Site metadata shown in the app.
EXPO_PUBLIC_SITE_NAME=B.Tech eKart
EXPO_PUBLIC_SUPPORT_EMAIL=support@btechekart.com
EXPO_PUBLIC_WHATSAPP_LINK=https://wa.me/919999999999
EXPO_PUBLIC_TELEGRAM_LINK=https://t.me/btechekart
