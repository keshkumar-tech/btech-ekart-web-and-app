DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL in production; sqlite default in dev)
DATABASE_URL=
DB_SSL_REQUIRE=False

# JWT
JWT_ACCESS_MINUTES=60

# CORS (web + mobile dev origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=B.Tech eKart <noreply@btechekart.com>

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (optional media hosting)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (optional private PDF storage with signed URLs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

PDF_URL_EXPIRY_SECONDS=600
MAX_DOWNLOADS_PER_ORDER_ITEM=5
WATERMARK_PDFS=True

# Cache / rate limiting (django-ratelimit). Leave blank for LocMemCache in dev.
# Production: redis://default:password@host:6379/0
REDIS_URL=

# Google login
GOOGLE_CLIENT_ID=

# Frontend URL (used in emails)
FRONTEND_URL=http://localhost:5173
