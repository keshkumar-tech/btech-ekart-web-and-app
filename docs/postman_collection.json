          "name": "Submit manual payment (UTR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"utr_number\": \"UTR123456789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderNumber}}/manual-payment/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderNumber}}", "manual-payment", ""]
            }
          }
        },
        {
          "name": "Download invoice (paid)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderNumber}}/invoice/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderNumber}}", "invoice", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Razorpay create order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_number\": \"{{orderNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/razorpay/create/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "razorpay", "create", ""]
            }
          }
        },
        {
          "name": "Razorpay verify signature",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_number\": \"{{orderNumber}}\",\n  \"razorpay_order_id\": \"order_xxx\",\n  \"razorpay_payment_id\": \"pay_xxx\",\n  \"razorpay_signature\": \"signature_from_client\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/razorpay/verify/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "razorpay", "verify", ""]
            }
          }
        },
        {
          "name": "Razorpay webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Razorpay-Signature", "value": "webhook_signature" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_1\",\n  \"event\": \"payment.captured\",\n  \"payload\": { \"payment\": { \"entity\": { \"id\": \"pay_xxx\", \"order_id\": \"order_xxx\", \"method\": \"upi\", \"notes\": { \"order_number\": \"{{orderNumber}}\" } } } }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/razorpay/webhook/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "razorpay", "webhook", ""]
            }
          }
        },
        {
          "name": "Manual QR details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/manual/{{orderNumber}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "manual", "{{orderNumber}}", ""]
            }
          }
        },
        {
          "name": "My payments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", ""]
            }
          }
        }
      ]
    },
