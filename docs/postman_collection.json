          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"WELCOME10\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/orders/coupon/apply/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "coupon", "apply", ""]
