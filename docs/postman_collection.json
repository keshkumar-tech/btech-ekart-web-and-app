{
  "info": {
    "name": "B.Tech eKart API",
    "description": "Complete REST collection for the B.Tech eKart backend (AKTU digital study material). Import into Postman, set the `baseUrl` variable, then run the Auth folder to capture the JWT automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "access", "value": "", "type": "string" },
    { "key": "refresh", "value": "", "type": "string" },
    { "key": "orderNumber", "value": "", "type": "string" },
    { "key": "productSlug", "value": "", "type": "string" },
    { "key": "orderItemId", "value": "", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Core",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access) { pm.collectionVariables.set('access', j.access); pm.collectionVariables.set('refresh', j.refresh); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newstudent@example.com\",\n  \"name\": \"New Student\",\n  \"phone\": \"9876543210\",\n  \"password\": \"StrongPass1\",\n  \"password2\": \"StrongPass1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "Login (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access) { pm.collectionVariables.set('access', j.access); pm.collectionVariables.set('refresh', j.refresh); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@btechekart.com\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access) { pm.collectionVariables.set('access', j.access); pm.collectionVariables.set('refresh', j.refresh); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@btechekart.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token/refresh/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            }
          }
        },
        {
          "name": "Profile (GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile", ""]
            }
          }
        },
        {
          "name": "Profile (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Student\",\n  \"college\": \"IET Lucknow\",\n  \"branch\": \"CSE\",\n  \"year\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile", ""]
            }
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@btechekart.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/password/forgot/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "password", "forgot", ""]
            }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@btechekart.com\",\n  \"otp\": \"123456\",\n  \"password\": \"NewStrong1\",\n  \"password2\": \"NewStrong1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/password/reset/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "password", "reset", ""]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalog/categories/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "categories", ""]
            }
          }
        },
        {
          "name": "Branches",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalog/branches/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "branches", ""]
            }
          }
        },
        {
          "name": "Subjects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalog/subjects/?branch__short_name=CSE&semester=3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "subjects", ""],
              "query": [
                { "key": "branch__short_name", "value": "CSE" },
                { "key": "semester", "value": "3" }
              ]
            }
          }
        },
        {
          "name": "Banners",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalog/banners/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "banners", ""]
            }
          }
        },
        {
          "name": "Products (filtered + sorted)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.results && j.results[0]) pm.collectionVariables.set('productSlug', j.results[0].slug);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalog/products/?branch__short_name=CSE&semester=3&type=notes&ordering=-price&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "products", ""],
              "query": [
                { "key": "branch__short_name", "value": "CSE" },
                { "key": "semester", "value": "3" },
                { "key": "type", "value": "notes" },
                { "key": "ordering", "value": "-price" },
                { "key": "page", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Products (search)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalog/products/?q=network",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "products", ""],
              "query": [{ "key": "q", "value": "network" }]
            }
          }
        },
        {
          "name": "Product detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalog/products/{{productSlug}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "products", "{{productSlug}}", ""]
            }
          }
        },
        {
          "name": "Product preview PDF",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalog/products/{{productSlug}}/preview/",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "catalog",
                "products",
                "{{productSlug}}",
                "preview",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cart & Wishlist",
      "item": [
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cart/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", ""]
            }
          }
        },
        {
          "name": "Add to cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/add/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "add", ""]
            }
          }
        },
        {
          "name": "Update cart item",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/cart/items/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "items", "1", ""]
            }
          }
        },
        {
          "name": "Remove cart item",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/cart/items/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "items", "1", ""]
            }
          }
        },
        {
          "name": "Get wishlist",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", ""]
            }
          }
        },
        {
          "name": "Add to wishlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"product_id\": 1\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/add/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "add", ""]
            }
          }
        },
        {
          "name": "Move wishlist → cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"product_id\": 1\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/move-to-cart/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "move-to-cart", ""]
            }
          }
        }
      ]
    },
    {
